variable "db_password" {
    type = string  
    default = "Password12345@"


validation {
    condition = 
        (
            length(var.db_password) >= 12 &&
            length(regexall("[$#@:]", var.db_password)) == 0
            # regexall(pattern, string) 
        )

    error_message = "Password must be at least 12 characters long and must not contain $, #, @, or :."
}

}

