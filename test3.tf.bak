variable "security_group_id" {
    default = "sg-068b18b63c60a3374"
}

data "aws_vpc_security_group_rules" "example1" {
  filter {
        name   = "group-id"
        values = [var.security_group_id]
  }
}

data "aws_vpc_security_group_rule" "example" {
  security_group_rule_id = data.aws_vpc_security_group_rules.example1.ids[1]
}

output "seruciry_group_rule" {
    value = data.aws_vpc_security_group_rule.example
}

output "security_group_rules" {
    value = data.aws_vpc_security_group_rules.example1.ids[1]
}
